# Environment variables understood by the project.
#
# IMPORTANT: this project does not load .env files automatically. Copy these
# values into your shell, notebook, or cloud environment, or set them with
# `set` (cmd), `$env:NAME=...` (PowerShell), or `export` (bash).
#
# Paths may be relative to the repository root or absolute.

# Optional: path to a YAML configuration. Scripts also accept --config.
# PLUME_CONFIG=config/default.yaml

# Optional: override paths.data_dir from the YAML configuration.
PLUME_DATA_DIR=

# Optional: override paths.outputs_dir from the YAML configuration.
PLUME_OUTPUT_DIR=

# Optional: override dataset.root. Leave empty to use paths.data_dir.
PLUME_DATASET_ROOT=
